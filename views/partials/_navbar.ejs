<!-- views/partials/_navbar.ejs -->
<nav class="navbar">
  <a class="brand" href="/">
    <span class="logo-mark" aria-hidden="true"></span>
    Health Registry
  </a>
  <div class="nav-links">
    <a href="/institutions">Institutions</a>
    <% if (user) { %>
      <a href="/institutions/new">Add institution</a>
      <a href="/users/profile">My profile</a>
      <span class="nav-user">Signed in as <%= user.username %></span>
      <a href="/auth/sign-out">Sign out</a>
    <% } else { %>
      <a href="/auth/sign-in">Sign in</a>
      <a class="btn" href="/auth/sign-up">Sign up</a>
    <% } %>
  </div>
</nav>
