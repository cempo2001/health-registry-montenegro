<!-- views/institutions/index.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>All institutions</title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <div class="page-header">
        <div>
          <h1>Healthcare institutions</h1>
          <p class="meta">Public and private institutions in one registry.</p>
        </div>
        <% if (user) { %>
          <a class="btn" href="/institutions/new">Add institution</a>
        <% } %>
      </div>

      <% if (institutions.length === 0) { %>
        <p>No institutions have been added yet.</p>
      <% } else { %>
        <ul class="card-grid">
          <% institutions.forEach((institution) => { %>
            <li class="card institution-card <%= institution.sector === "Public" ? "institution-card-public" : "institution-card-private" %>">
              <div class="card-body">
                <p class="badges">
                  <span class="badge <%= institution.sector === "Public" ? "badge-public" : "badge-private" %>"><%= institution.sector %></span>
                  <span class="badge badge-type"><%= institution.type %></span>
                </p>
                <h3><a href="/institutions/<%= institution._id %>"><%= institution.name %></a></h3>
                <p class="meta">
                  <%= institution.city %><% if (institution.address) { %>, <%= institution.address %><% } %>
                </p>
                <% if (institution.phone) { %>
                  <p class="meta">Phone: <%= institution.phone %></p>
                <% } %>
              </div>
              <div class="card-footer">
                <span class="avatar" aria-hidden="true"><%= institution.owner.username.charAt(0).toUpperCase() %></span>
                <span class="meta">Added by <strong><%= institution.owner.username %></strong></span>
                <a class="card-link" href="/institutions/<%= institution._id %>">View details</a>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
    <%- include("../partials/_footer.ejs") %>
  </body>
</html>
