<!-- views/institutions/index.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>All institutions</title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <h1>Healthcare institutions</h1>

      <% if (user) { %>
        <a href="/institutions/new">Add institution</a>
      <% } %>

      <% if (institutions.length === 0) { %>
        <p>No institutions have been added yet.</p>
      <% } else { %>
        <ul>
          <% institutions.forEach((institution) => { %>
            <li>
              <a href="/institutions/<%= institution._id %>"><%= institution.name %></a>
              (<%= institution.sector %>, <%= institution.type %>, <%= institution.city %>)
              <br />
              Added by: <%= institution.owner.username %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
