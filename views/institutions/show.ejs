<!-- views/institutions/show.ejs -->
<!DOCTYPE html>
<html lang="sr-Latn-ME">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title><%= institution.name %></title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <h1><%= institution.name %></h1>

      <h2>Podaci</h2>
      <p>Sektor: <%= institution.sector %></p>
      <p>Vrsta: <%= institution.type %></p>
      <p>Grad: <%= institution.city %></p>
      <% if (institution.address) { %>
        <p>Adresa: <%= institution.address %></p>
      <% } %>
      <% if (institution.phone) { %>
        <p>Telefon: <%= institution.phone %></p>
      <% } %>
      <% if (institution.email) { %>
        <p>Email: <%= institution.email %></p>
      <% } %>

      <h2>Omiljene</h2>
      <p>Broj korisnika kojima je ustanova omiljena: <%= institution.favoritedByUsers.length %></p>
      <% if (user) { %>
        <% if (institution.favoritedByUsers.some((id) => id.equals(user._id))) { %>
          <form action="/institutions/<%= institution._id %>/favorite?_method=DELETE" method="POST">
            <button type="submit">Ukloni iz omiljenih</button>
          </form>
        <% } else { %>
          <form action="/institutions/<%= institution._id %>/favorite" method="POST">
            <button type="submit">Dodaj u omiljene</button>
          </form>
        <% } %>
      <% } %>

      <h2>Zdravstveni radnici</h2>
      <% if (professionals.length === 0) { %>
        <p>Za ovu ustanovu još nema unesenih radnika.</p>
      <% } else { %>
        <ul>
          <% professionals.forEach((professional) => { %>
            <li>
              <%= professional.name %> - <%= professional.profession %>
              <% if (professional.specialty) { %>
                (<%= professional.specialty %>)
              <% } %>
              <% if (user && institution.owner._id.equals(user._id)) { %>
                <a href="/institutions/<%= institution._id %>/professionals/<%= professional._id %>/edit">Izmijeni</a>
                <form action="/institutions/<%= institution._id %>/professionals/<%= professional._id %>?_method=DELETE" method="POST">
                  <button type="submit">Obriši</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h2>Unio/la u registar</h2>
      <p><%= institution.owner.username %></p>

      <!-- Dugmad vidi samo vlasnik; server to provjerava i na svakoj ruti -->
      <% if (user && institution.owner._id.equals(user._id)) { %>
        <a href="/institutions/<%= institution._id %>/edit">Izmijeni ustanovu</a>

        <a href="/institutions/<%= institution._id %>/professionals/new">Dodaj radnika</a>

        <form action="/institutions/<%= institution._id %>?_method=DELETE" method="POST">
          <button type="submit">Obriši ustanovu</button>
        </form>
      <% } %>

      <a href="/institutions">Nazad na ustanove</a>
    </main>
  </body>
</html>
