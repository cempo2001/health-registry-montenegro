<!-- views/professionals/edit.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Edit professional</title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <h1>Edit professional</h1>
      <p>Institution: <%= institution.name %></p>

      <form class="form-card" action="/institutions/<%= institution._id %>/professionals/<%= professional._id %>?_method=PUT" method="POST">
        <label for="name">Full name:</label>
        <input type="text" name="name" id="name" value="<%= professional.name %>" required />

        <label for="profession">Profession:</label>
        <select name="profession" id="profession" required>
          <option value="Physician" <%= professional.profession === "Physician" ? "selected" : "" %>>Physician</option>
          <option value="Nurse / Technician" <%= professional.profession === "Nurse / Technician" ? "selected" : "" %>>Nurse / Technician</option>
          <option value="Pharmacist" <%= professional.profession === "Pharmacist" ? "selected" : "" %>>Pharmacist</option>
          <option value="Dentist" <%= professional.profession === "Dentist" ? "selected" : "" %>>Dentist</option>
          <option value="Laboratory technician" <%= professional.profession === "Laboratory technician" ? "selected" : "" %>>Laboratory technician</option>
        </select>

        <label for="specialty">Specialty:</label>
        <input type="text" name="specialty" id="specialty" value="<%= professional.specialty %>" />

        <button type="submit">Save changes</button>
      </form>

      <a href="/institutions/<%= institution._id %>">Back to institution</a>
    </main>
    <%- include("../partials/_footer.ejs") %>
  </body>
</html>
