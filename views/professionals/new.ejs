<!-- views/professionals/new.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>New healthcare professional</title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <h1>Add healthcare professional</h1>
      <p>Institution: <%= institution.name %></p>

      <form class="form-card" action="/institutions/<%= institution._id %>/professionals" method="POST">
        <label for="name">Full name:</label>
        <input type="text" name="name" id="name" required />

        <label for="profession">Profession:</label>
        <select name="profession" id="profession" required>
          <option value="Physician">Physician</option>
          <option value="Nurse / Technician">Nurse / Technician</option>
          <option value="Pharmacist">Pharmacist</option>
          <option value="Dentist">Dentist</option>
          <option value="Laboratory technician">Laboratory technician</option>
        </select>

        <label for="specialty">Specialty:</label>
        <input type="text" name="specialty" id="specialty" />

        <button type="submit">Save professional</button>
      </form>

      <a href="/institutions/<%= institution._id %>">Back to institution</a>
    </main>
    <%- include("../partials/_footer.ejs") %>
  </body>
</html>
