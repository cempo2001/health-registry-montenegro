<!-- views/users/profile.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>My profile</title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <h1>My profile</h1>
      <p class="meta">Signed in as <%= user.username %></p>

      <h2>Favorite institutions</h2>
      <% if (favorites.length === 0) { %>
        <p>You have no favorite institutions yet.</p>
      <% } else { %>
        <ul class="card-grid">
          <% favorites.forEach((institution) => { %>
            <li class="card">
              <h3><a href="/institutions/<%= institution._id %>"><%= institution.name %></a></h3>
              <p class="meta"><%= institution.type %>, <%= institution.city %></p>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h2>Institutions I added</h2>
      <% if (myInstitutions.length === 0) { %>
        <p>You have not added any institutions yet.</p>
      <% } else { %>
        <ul class="card-grid">
          <% myInstitutions.forEach((institution) => { %>
            <li class="card">
              <h3><a href="/institutions/<%= institution._id %>"><%= institution.name %></a></h3>
              <p class="meta"><%= institution.type %>, <%= institution.city %></p>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
    <%- include("../partials/_footer.ejs") %>
  </body>
</html>
