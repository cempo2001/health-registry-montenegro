<!-- views/users/profile.ejs -->
<!DOCTYPE html>
<html lang="sr-Latn-ME">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Moj profil</title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <h1>Moj profil: <%= user.username %></h1>

      <h2>Omiljene ustanove</h2>
      <% if (favorites.length === 0) { %>
        <p>Još nemaš omiljenih ustanova.</p>
      <% } else { %>
        <ul>
          <% favorites.forEach((institution) => { %>
            <li>
              <a href="/institutions/<%= institution._id %>"><%= institution.name %></a>
              (<%= institution.city %>)
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h2>Ustanove koje sam unio/la</h2>
      <% if (myInstitutions.length === 0) { %>
        <p>Još nisi unio/la nijednu ustanovu.</p>
      <% } else { %>
        <ul>
          <% myInstitutions.forEach((institution) => { %>
            <li>
              <a href="/institutions/<%= institution._id %>"><%= institution.name %></a>
              (<%= institution.city %>)
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
