<!-- views/users/profile.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>My profile</title>
  </head>
  <body>
    <%- include("../partials/_navbar.ejs") %>
    <main>
      <h1>My profile: <%= user.username %></h1>

      <h2>Favorite institutions</h2>
      <% if (favorites.length === 0) { %>
        <p>You have no favorite institutions yet.</p>
      <% } else { %>
        <ul>
          <% favorites.forEach((institution) => { %>
            <li>
              <a href="/institutions/<%= institution._id %>"><%= institution.name %></a>
              (<%= institution.city %>)
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h2>Institutions I added</h2>
      <% if (myInstitutions.length === 0) { %>
        <p>You have not added any institutions yet.</p>
      <% } else { %>
        <ul>
          <% myInstitutions.forEach((institution) => { %>
            <li>
              <a href="/institutions/<%= institution._id %>"><%= institution.name %></a>
              (<%= institution.city %>)
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
